<?xml version="1.0" encoding="utf-8"?>
<!--
    Version PAYSAGE de l'écran d'accueil. Tuiles en hauteur NATURELLE
    (wrap_content, pas un pourcentage de l'écran) + ScrollView de secours,
    pour ne jamais comprimer icône/texte au point de les faire disparaître
    (voir capture utilisateur du bug précédent). Icônes vectorielles +
    effet "pop" au focus, comme la version portrait.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_home_screen">

    <View
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:background="@color/solplay_orange" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="6dp">

        <ImageView
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginEnd="10dp"
            android:src="@drawable/ic_solplay_logo"
            android:contentDescription="SOLPLAY" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SOLPLAY"
            android:textColor="@color/solplay_white"
            android:textStyle="bold"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/tvClock"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text=""
            android:textColor="@color/solplay_white"
            android:textSize="1sp"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Conservés pour ActivityHomeBinding (code existant) - fonctions
         retirées de cette maquette, invisibles, sans effet. -->
    <LinearLayout
        android:id="@+id/tileAccount"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:background="@android:color/transparent"
        android:clickable="false"
        android:focusable="false"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/tileChangeServer"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:background="@android:color/transparent"
        android:clickable="false"
        android:focusable="false"
        android:visibility="gone" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <!-- Grille 2 colonnes x 3 rangées - hauteur NATURELLE (wrap_content),
             jamais compressée par la hauteur de l'écran. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <!-- Rangée 1 : Live TV | Films -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/tileLiveTv"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_margin="5dp"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:padding="10dp"
                    android:background="@drawable/bg_home_tile"
                    android:stateListAnimator="@animator/tile_focus_pop"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@drawable/ic_tile_live"
                        android:contentDescription="TV LIVE" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="TV LIVE"
                        android:textAllCaps="true"
                        android:textColor="@color/solplay_white"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        android:letterSpacing="0.08" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tileMovies"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_margin="5dp"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:padding="10dp"
                    android:background="@drawable/bg_home_tile"
                    android:stateListAnimator="@animator/tile_focus_pop"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@drawable/ic_tile_films"
                        android:contentDescription="Films" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="Films"
                        android:textColor="@color/solplay_white"
                        android:textStyle="bold"
                        android:textSize="14sp" />
                </LinearLayout>

            </LinearLayout>

            <!-- Rangée 2 : Séries | Compte -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/tileSeries"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_margin="5dp"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:padding="10dp"
                    android:background="@drawable/bg_home_tile"
                    android:stateListAnimator="@animator/tile_focus_pop"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_tile_series"
                        android:contentDescription="Séries" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="Séries"
                        android:textColor="@color/solplay_white"
                        android:textStyle="bold"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tileFavorites"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_margin="5dp"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:padding="10dp"
                    android:background="@drawable/bg_home_tile"
                    android:stateListAnimator="@animator/tile_focus_pop"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@drawable/ic_tile_account"
                        android:contentDescription="Compte" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="Compte"
                        android:textColor="@color/solplay_white"
                        android:textStyle="bold"
                        android:textSize="14sp" />
                </LinearLayout>

            </LinearLayout>

            <!-- Rangée 3 : Changer serveur | Replay -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/tileSettings"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_margin="5dp"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:padding="10dp"
                    android:background="@drawable/bg_home_tile"
                    android:stateListAnimator="@animator/tile_focus_pop"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@drawable/ic_tile_changeserver"
                        android:contentDescription="Changer serveur" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="Changer serveur"
                        android:textColor="@color/solplay_white"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:maxLines="1" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tileHistory"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_margin="5dp"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:padding="10dp"
                    android:background="@drawable/bg_home_tile"
                    android:stateListAnimator="@animator/tile_focus_pop"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@drawable/ic_tile_replay"
                        android:contentDescription="Replay" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="Replay"
                        android:textColor="@color/solplay_white"
                        android:textStyle="bold"
                        android:textSize="14sp" />
                </LinearLayout>

            </LinearLayout>

            <!-- Tuile Reprendre (visible uniquement si une lecture récente existe) -->
            <LinearLayout
                android:id="@+id/tileResume"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="@color/solplay_orange"
                android:clickable="true"
                android:focusable="true"
                android:padding="10dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvResumeLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Reprendre"
                    android:textColor="@color/solplay_white"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:ellipsize="end"
                    android:maxLines="1" />
            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="6dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/tvExpiration"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/solplay_white"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvConnectedAs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/solplay_white"
            android:textSize="11sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:background="@color/solplay_orange" />

</LinearLayout>
