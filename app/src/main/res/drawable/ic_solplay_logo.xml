<?xml version="1.0" encoding="utf-8"?>
<!--
    Logo SolPlay (v2) : disque "soleil" orange avec de fins rayons autour
    (référence à "Sol"), un anneau cyan fin qui reprend l'accent de marque
    utilisé partout ailleurs dans l'app, et un triangle "lecture" blanc
    recentré au milieu exact du disque. Entièrement vectoriel, sans reprise
    d'aucun élément visuel tiers.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Rayons de soleil, fins, autour du disque -->
    <path
        android:fillColor="#FF7A00"
        android:fillAlpha="0.55"
        android:pathData="M12,0 L12.9,2.6 L11.1,2.6 Z" />
    <path
        android:fillColor="#FF7A00"
        android:fillAlpha="0.55"
        android:pathData="M12,24 L12.9,21.4 L11.1,21.4 Z" />
    <path
        android:fillColor="#FF7A00"
        android:fillAlpha="0.55"
        android:pathData="M0,12 L2.6,12.9 L2.6,11.1 Z" />
    <path
        android:fillColor="#FF7A00"
        android:fillAlpha="0.55"
        android:pathData="M24,12 L21.4,12.9 L21.4,11.1 Z" />
    <path
        android:fillColor="#FF7A00"
        android:fillAlpha="0.4"
        android:pathData="M3.5,3.5 L5.6,4.9 L4.9,5.6 Z" />
    <path
        android:fillColor="#FF7A00"
        android:fillAlpha="0.4"
        android:pathData="M20.5,20.5 L18.4,19.1 L19.1,18.4 Z" />
    <path
        android:fillColor="#FF7A00"
        android:fillAlpha="0.4"
        android:pathData="M20.5,3.5 L18.4,4.9 L19.1,5.6 Z" />
    <path
        android:fillColor="#FF7A00"
        android:fillAlpha="0.4"
        android:pathData="M3.5,20.5 L5.6,19.1 L4.9,18.4 Z" />

    <!-- Anneau cyan fin (accent de marque) -->
    <path
        android:fillColor="#00E5FF"
        android:pathData="M12,2.4 A9.6,9.6 0 1,1 11.99,2.4 Z" />

    <!-- Disque "soleil" orange -->
    <path
        android:fillColor="#FF7A00"
        android:pathData="M12,3.2 A8.8,8.8 0 1,1 11.99,3.2 Z" />

    <!-- Léger halo intérieur pour donner du relief au disque -->
    <path
        android:fillColor="#E56A00"
        android:fillAlpha="0.35"
        android:pathData="M12,5 A7,7 0 1,1 11.99,5 Z" />

    <!-- Triangle de lecture, recentré au milieu exact du disque -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M9.8,7.8 L16.6,12 L9.8,16.2 Z" />

</vector>

