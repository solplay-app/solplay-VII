<?xml version="1.0" encoding="utf-8"?>
<!-- Cadre d'une tuile affiche de la rangée d'accueil :
     - Repos  : liseré CYAN fin permanent → tuile toujours visible.
     - Focus  : liseré ORANGE épais + halo léger visible à la télécommande.
     Le sélecteur est donc visible sur l'écran d'accueil, comme demandé. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#1FFF7A00" />
            <corners android:radius="12dp" />
            <stroke android:width="4dp" android:color="@color/solplay_orange" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#1FFF7A00" />
            <corners android:radius="12dp" />
            <stroke android:width="3dp" android:color="@color/solplay_orange" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#1500F5FF" />
            <corners android:radius="12dp" />
            <stroke android:width="3dp" android:color="@color/solplay_orange" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="12dp" />
            <stroke android:width="2dp" android:color="#8000F5FF" />
        </shape>
    </item>
</selector>