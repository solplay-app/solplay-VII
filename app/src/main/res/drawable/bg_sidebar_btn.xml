<?xml version="1.0" encoding="utf-8"?>
<!--
    Bouton circulaire pour la sidebar étroite. État repos : surface sombre
    légèrement transparente ; état focusé : halo orange vif avec liseré
    blanc, exactement comme sur la maquette (icône TV Live en orange plein,
    les autres en transparence sombre).
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="oval">
            <solid android:color="@color/solplay_orange" />
            <stroke android:width="2dp" android:color="@color/solplay_white" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="@color/solplay_orange_dark" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="oval">
            <solid android:color="@color/solplay_orange" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="#2200F5FF" />
            <stroke android:width="1dp" android:color="#6600F5FF" />
        </shape>
    </item>
</selector>
