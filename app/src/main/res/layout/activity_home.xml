<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/homeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/bg_home_screen">

    <!-- Sidebar élargie (150dp) pour contenir l'icône ronde + le libellé
         (LIVE / MOVIES / SERIES) sur une seule ligne, SANS débordement. -->
    <LinearLayout
        android:id="@+id/sidebar"
        android:layout_width="150dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="14dp"
        android:paddingBottom="16dp"
        android:background="#B3000610">

        <Space android:layout_width="1dp" android:layout_height="22dp" />

        <!-- Toutes les rangées ci-dessous utilisent désormais layout_width="match_parent"
             + paddingStart identique (20dp) : les icônes démarrent toutes exactement
             au même x, qu'il y ait un libellé à côté (LIVE/MOVIES/SERIES) ou non
             (compte/actualiser). Avant, chaque rangée était en wrap_content et se
             centrait indépendamment dans la sidebar → icônes désalignées. -->
        <LinearLayout android:id="@+id/rowLive"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal"
            android:paddingStart="20dp"
            android:focusable="true" android:clickable="true"
            android:nextFocusDown="@id/rowMovies">
            <ImageView android:id="@+id/tileLiveTv" android:layout_width="60dp" android:layout_height="60dp"
                android:padding="10dp" android:background="@drawable/bg_sidebar_btn"
                android:src="@drawable/ic_tile_live" android:focusable="true"
                android:contentDescription="Live" android:duplicateParentState="true" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="LIVE" android:textColor="@color/solplay_white"
                android:textStyle="bold" android:textSize="16sp"
                android:layout_marginStart="8dp" android:duplicateParentState="true" />
        </LinearLayout>

        <Space android:layout_width="1dp" android:layout_height="14dp" />

        <LinearLayout android:id="@+id/rowMovies"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal"
            android:paddingStart="20dp"
            android:focusable="true" android:clickable="true"
            android:nextFocusUp="@id/rowLive" android:nextFocusDown="@id/rowSeries">
            <ImageView android:id="@+id/tileMovies" android:layout_width="60dp" android:layout_height="60dp"
                android:padding="10dp" android:background="@drawable/bg_sidebar_btn"
                android:src="@drawable/ic_tile_films" android:focusable="true"
                android:contentDescription="Movies" android:duplicateParentState="true" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="MOVIES" android:textColor="@color/solplay_white"
                android:textStyle="bold" android:textSize="15sp"
                android:layout_marginStart="8dp" android:duplicateParentState="true" />
        </LinearLayout>

        <Space android:layout_width="1dp" android:layout_height="14dp" />

        <LinearLayout android:id="@+id/rowSeries"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal"
            android:paddingStart="20dp"
            android:focusable="true" android:clickable="true"
            android:nextFocusUp="@id/rowMovies" android:nextFocusDown="@id/rowAccount">
            <ImageView android:id="@+id/tileSeries" android:layout_width="60dp" android:layout_height="60dp"
                android:padding="10dp" android:background="@drawable/bg_sidebar_btn"
                android:src="@drawable/ic_tile_series" android:focusable="true"
                android:contentDescription="Series" android:duplicateParentState="true" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="SERIES" android:textColor="@color/solplay_white"
                android:textStyle="bold" android:textSize="15sp"
                android:layout_marginStart="8dp" android:duplicateParentState="true" />
        </LinearLayout>

        <Space android:layout_width="1dp" android:layout_height="14dp" />

        <LinearLayout android:id="@+id/rowAccount"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal"
            android:paddingStart="20dp"
            android:focusable="true" android:clickable="true"
            android:nextFocusUp="@id/rowSeries" android:nextFocusDown="@id/rowRefresh">
            <ImageView android:id="@+id/tileAccount" android:layout_width="60dp" android:layout_height="60dp"
                android:padding="10dp" android:background="@drawable/bg_sidebar_btn"
                android:src="@drawable/ic_tile_account" android:focusable="false"
                android:clickable="false" android:contentDescription="Compte"
                android:duplicateParentState="true" />
            <Space android:layout_width="8dp" android:layout_height="1dp" />
        </LinearLayout>

        <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />

        <LinearLayout android:id="@+id/rowRefresh"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal"
            android:paddingStart="20dp"
            android:focusable="true" android:clickable="true"
            android:nextFocusUp="@id/rowAccount">
            <ImageView android:id="@+id/tileChangeServer" android:layout_width="60dp" android:layout_height="60dp"
                android:padding="10dp" android:background="@drawable/bg_sidebar_btn"
                android:src="@drawable/ic_tile_changeserver" android:focusable="false"
                android:clickable="false" android:contentDescription="Actualiser"
                android:duplicateParentState="true" />
            <Space android:layout_width="8dp" android:layout_height="1dp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="1" android:orientation="vertical">

        <!-- Barre du haut : logo + USER / EXPIRE + icônes droite. -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="72dp"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:paddingStart="20dp" android:paddingEnd="20dp">
            <ImageView android:layout_width="38dp" android:layout_height="38dp"
                android:src="@drawable/ic_solplay_logo" android:contentDescription="Logo" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="SOL" android:textColor="@color/solplay_white"
                android:textStyle="bold" android:textSize="21sp"
                android:layout_marginStart="6dp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="PLAY" android:textColor="@color/solplay_orange"
                android:textStyle="bold" android:textSize="21sp" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical"
                android:layout_marginStart="44dp">
                <TextView android:id="@+id/tvConnectedAs" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="USER: TEST"
                    android:textColor="@color/solplay_white_60" android:textSize="11sp" />
                <TextView android:id="@+id/tvExpiration" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="EXPIRE: 11/09/2026"
                    android:textColor="@color/solplay_white_60" android:textSize="11sp" />
            </LinearLayout>
            <ImageView android:id="@+id/tileHistory" android:layout_width="52dp" android:layout_height="52dp"
                android:padding="12dp" android:background="@drawable/bg_icon_circle"
                android:src="@drawable/ic_tile_replay" android:clickable="true"
                android:focusable="true" android:contentDescription="Historique" />
            <ImageView android:id="@+id/tileFavorites" android:layout_width="52dp" android:layout_height="52dp"
                android:layout_marginStart="14dp" android:padding="12dp"
                android:background="@drawable/bg_icon_circle" android:src="@drawable/ic_tile_star"
                android:clickable="true" android:focusable="true" android:contentDescription="Favoris" />
            <ImageView android:id="@+id/tileSettings" android:layout_width="52dp" android:layout_height="52dp"
                android:layout_marginStart="14dp" android:padding="12dp"
                android:background="@drawable/bg_icon_circle" android:src="@drawable/ic_tile_playlist"
                android:clickable="true" android:focusable="true" android:contentDescription="Menu" />
        </LinearLayout>

        <!-- HERO : zone de la miniature rotative avec CROSSFADE.
             layout_weight="1" (flexible) : le hero prend TOUT l'espace vertical
             restant une fois les blocs à hauteur fixe déduits (barre du haut,
             CTA, titre de section, et la rangée de tuiles ci-dessous qui a,
             elle, une hauteur FIXE garantie — voir recyclerHomePostersTop).
             Ce découpage évite tout risque de chevauchement entre le hero et
             les tuiles, quelle que soit la hauteur d'écran réelle. -->
        <FrameLayout android:id="@+id/heroContainer"
            android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="120dp"
            android:layout_marginStart="18dp" android:layout_marginEnd="18dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_hero_placeholder" android:clipToOutline="true">
            <View android:id="@+id/heroBackdropTint" android:layout_width="match_parent"
                android:layout_height="match_parent" android:background="@android:color/transparent" />
            <ImageView android:id="@+id/ivHeroPlaceholderLogo"
                android:layout_width="72dp" android:layout_height="72dp"
                android:layout_gravity="center" android:alpha="0.35"
                android:src="@drawable/ic_solplay_logo"
                android:contentDescription="" />
            <ImageView android:id="@+id/ivHeroBackdrop" android:layout_width="match_parent"
                android:layout_height="match_parent" android:scaleType="centerCrop"
                android:background="@android:color/transparent"
                android:contentDescription="Miniature du film sélectionné"
                android:alpha="0" />
            <ImageView android:id="@+id/ivHeroBackdropNext" android:layout_width="match_parent"
                android:layout_height="match_parent" android:scaleType="centerCrop"
                android:background="@android:color/transparent"
                android:contentDescription="" android:alpha="0" />
        </FrameLayout>

        <!-- Ligne CTA : LECTURE + MA LISTE. -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="54dp"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:paddingStart="60dp" android:paddingEnd="40dp">
            <!-- Le libellé "LECTURE" était auparavant orange sur fond orange — illisible.
                 On le force en blanc pour qu'il contraste nettement avec le bouton. -->
            <Button android:id="@+id/btnHeroPlay" android:layout_width="wrap_content"
                android:layout_height="42dp" android:background="@drawable/bg_hero_btn_play"
                android:text="LECTURE" android:textColor="@color/solplay_white"
                android:textStyle="bold" android:textSize="14sp"
                android:paddingStart="24dp" android:paddingEnd="24dp" />
            <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
            <Button android:id="@+id/btnHeroMyList" android:layout_width="wrap_content"
                android:layout_height="42dp" android:background="@drawable/bg_hero_btn_ghost"
                android:text="MA LISTE" android:textColor="#00F5FF" android:textStyle="bold"
                android:textSize="14sp" android:paddingStart="24dp" android:paddingEnd="24dp" />
        </LinearLayout>

        <!-- Titre de la section + libellé "MA LISTE" si besoin.
             On garde LA SEULE rangée telle que la maquette la décrit :
             "🔥 SELECTION DU JOUR - TOP FILMS" -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="38dp"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:paddingStart="30dp">
            <TextView android:id="@+id/tvPosterSectionLabel" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="🔥 SELECTION DU JOUR - TOP FILMS"
                android:textColor="@color/solplay_white" android:textStyle="bold"
                android:textSize="15sp" />
        </LinearLayout>

        <!--
            ===========================================================
            UNE SEULE SECTION DE TUILES sur l'écran d'accueil (Films),
            conforme à la maquette : plus de rangée Séries ici (les séries
            restent accessibles via le menu latéral SERIES).
            recyclerHomePostersTop utilise un GridLayoutManager span=2 →
            2 rangées de tuiles au total, comme demandé.

            HAUTEUR FIXE (au lieu d'un layout_weight) : c'est la garantie
            anti-chevauchement. Chaque tuile fait 100dp + 10dp de marge basse
            (item_home_poster.xml) → 2 rangées = 220dp, + 12dp de padding bas
            du RecyclerView + 4dp de padding haut = 236dp. Avec un pourcentage
            (weight), la place réellement disponible dépend de la hauteur de
            l'écran et pouvait devenir insuffisante sur certains appareils,
            ce qui écrase/chevauche visuellement la 2e rangée sur la 1re dans
            un GridLayoutManager horizontal (le span est réparti sur la
            hauteur allouée, donc s'il manque de place, les rangées se
            resserrent l'une sur l'autre). Une hauteur FIXE, dimensionnée
            exactement pour le contenu réel, élimine ce risque : les 2
            rangées ont TOUJOURS assez de place, jamais plus, jamais moins.
            ===========================================================
        -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerHomePostersTop"
            android:layout_width="match_parent" android:layout_height="236dp"
            android:clipToPadding="false"
            android:paddingStart="34dp" android:paddingEnd="34dp"
            android:paddingTop="4dp" android:paddingBottom="12dp" />

        <!-- Recyclerview Séries de l'accueil retirée (span demandé : 2 rangées
             au total sur l'écran d'accueil). L'ID est conservé caché (1dp/gone)
             pour ne pas casser le binding généré par ViewBinding. -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerHomePostersBot"
            android:layout_width="1dp" android:layout_height="1dp"
            android:visibility="gone" />

        <!-- Anciens IDs conservés (1dp / gone) pour ne pas casser le binding code généré. -->
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/recyclerHomePosters"
            android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
        <LinearLayout android:id="@+id/cardLive" android:layout_width="1dp"
            android:layout_height="1dp" android:visibility="gone" />
        <LinearLayout android:id="@+id/cardMovies" android:layout_width="1dp"
            android:layout_height="1dp" android:visibility="gone" />
        <LinearLayout android:id="@+id/cardSeries" android:layout_width="1dp"
            android:layout_height="1dp" android:visibility="gone" />
        <TextView android:id="@+id/pillUpdateEpg" android:layout_width="1dp"
            android:layout_height="1dp" android:visibility="gone" />
        <TextView android:id="@+id/pillAccount" android:layout_width="1dp"
            android:layout_height="1dp" android:visibility="gone" />
        <TextView android:id="@+id/pillCatchUp" android:layout_width="1dp"
            android:layout_height="1dp" android:visibility="gone" />
        <LinearLayout android:id="@+id/tileResume" android:layout_width="1dp"
            android:layout_height="1dp" android:visibility="gone">
            <TextView android:id="@+id/tvResumeLabel" android:layout_width="1dp"
                android:layout_height="1dp" />
        </LinearLayout>
        <TextView android:id="@+id/tvHeroBadge" android:layout_width="1dp"
            android:layout_height="1dp" android:visibility="gone" />
        <TextView android:id="@+id/tvHeroTitle" android:layout_width="1dp"
            android:layout_height="1dp" android:visibility="gone" />
        <TextView android:id="@+id/tvHeroRating" android:layout_width="1dp"
            android:layout_height="1dp" android:visibility="gone" />
        <TextView android:id="@+id/tvHeroDuration" android:layout_width="1dp"
            android:layout_height="1dp" android:visibility="gone" />
        <TextView android:id="@+id/tvHeroLang" android:layout_width="1dp"
            android:layout_height="1dp" android:visibility="gone" />
        <TextView android:id="@+id/tvHeroQuality" android:layout_width="1dp"
            android:layout_height="1dp" android:visibility="gone" />
        <TextView android:id="@+id/tvHeroDescription" android:layout_width="1dp"
            android:layout_height="1dp" android:visibility="gone" />
        <TextView android:id="@+id/tvClock" android:layout_width="1dp"
            android:layout_height="1dp" android:visibility="gone" />
    </LinearLayout>
</LinearLayout>