<?xml version="1.0" encoding="utf-8"?>
<!--
    CORRECTIF (demande client) : écran figé, sans défilement.

    Avant : ScrollView + LinearLayout, avec la clé appareil affichée en clair
    dans une grande zone de texte, un bouton "Copier" pleine largeur séparé,
    et le contact (email/téléphone) tout en bas de l'écran (invisible sans
    défiler). L'utilisateur devait défiler pour voir le reste de l'écran.

    Après : tout tient sur un seul écran fixe (plus de ScrollView) :
     - le bouton "Afficher le QR code" est en haut à droite (au lieu d'un QR
       toujours visible qui prenait de la place) : il ouvre le QR code dans
       une boîte de dialogue au milieu de l'écran, qu'on ferme en cliquant
       dessus (voir showDeviceKeyQrDialog() dans LicenseActivity.kt) ;
     - le contact revendeur (email/téléphone) est déplacé juste sous les
       boutons "Contacter le revendeur" / "Payer en ligne", comme demandé ;
     - la clé appareil n'est plus affichée dans un gros bloc de texte : une
       simple ligne "clé + bouton Copier" compacte la remplace.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/solplay_bg_dark"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="16dp"
    android:paddingBottom="16dp">

    <!-- ===================== EN-TETE : titre + bouton QR code ===================== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textColor="@color/solplay_orange"
            android:textSize="28sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnShowQr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:textSize="12sp"
            android:minWidth="0dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Afficher QR code" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:textColor="@color/solplay_text_primary_dark"
        android:textSize="16sp" />

    <!-- ===================== ETAT BLOQUE (essai + licence expirees) ===================== -->
    <LinearLayout
        android:id="@+id/groupBlocked"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:background="@color/solplay_gray"
        android:padding="14dp"
        android:layout_marginTop="12dp">

        <TextView
            android:id="@+id/tvBlockedTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/access_blocked_title"
            android:textColor="@color/solplay_orange_dark"
            android:textStyle="bold"
            android:textSize="16sp"
            android:gravity="center" />

        <TextView
            android:id="@+id/tvBlockedMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/access_blocked_message"
            android:textColor="@color/solplay_text_primary_dark"
            android:textSize="13sp"
            android:lineSpacingExtra="2dp" />

        <!-- Bouton cliquable WhatsApp -->
        <LinearLayout
            android:id="@+id/btnWhatsApp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_whatsapp_button"
            android:clickable="true"
            android:focusable="true"
            android:padding="12dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_whatsapp"
                android:contentDescription="@string/btn_whatsapp_contact" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text="@string/btn_whatsapp_contact"
                android:textColor="@color/solplay_white"
                android:textStyle="bold"
                android:textSize="15sp"
                android:gravity="center" />
        </LinearLayout>

        <Button
            android:id="@+id/btnPayOnline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:backgroundTint="@color/solplay_orange"
            android:text="Payer en ligne"
            android:textColor="@color/solplay_white" />

        <!-- ===================== CONTACT REVENDEUR ===================== -->
        <!-- Déplacé ici, juste sous les boutons, comme demandé (avant : tout
             en bas de l'écran, invisible sans défiler). -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:textColor="@color/solplay_text_secondary"
            android:textSize="12sp"
            android:text="@string/contact_email" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/solplay_text_secondary"
            android:textSize="12sp"
            android:text="@string/contact_phone" />
    </LinearLayout>

    <Button
        android:id="@+id/btnContinueTrial"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:backgroundTint="@color/solplay_green"
        android:text="@string/btn_continue_trial"
        android:textColor="@color/solplay_white" />

    <!-- Zone qui absorbe l'espace restant, pour que le bloc "clé appareil" et
         les boutons du dessous restent groupés en bas de l'écran fixe, quelle
         que soit la hauteur de l'écran (au lieu de flotter au milieu). -->
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/solplay_gray" />

    <!-- ===================== CLE APPAREIL (ligne compacte + bouton Copier) ===================== -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Votre clé appareil :"
        android:textColor="@color/solplay_text_secondary"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/solplay_gray"
        android:padding="10dp">

        <TextView
            android:id="@+id/tvDeviceKey"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/solplay_text_primary_dark"
            android:textStyle="bold"
            android:textSize="14sp"
            android:textIsSelectable="true" />

        <TextView
            android:id="@+id/btnCopyDeviceKey"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:clickable="true"
            android:focusable="true"
            android:padding="6dp"
            android:text="Copier"
            android:textColor="@color/solplay_orange"
            android:textStyle="bold"
            android:textSize="13sp" />
    </LinearLayout>

    <Button
        android:id="@+id/btnVerifyActivation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:backgroundTint="@color/solplay_green"
        android:text="Verifier mon activation"
        android:textColor="@color/solplay_white" />

    <ProgressBar
        android:id="@+id/progressBarLicense"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:visibility="gone" />

</LinearLayout>
